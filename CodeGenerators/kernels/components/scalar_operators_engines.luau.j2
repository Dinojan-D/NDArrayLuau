{%macro classic(dtype,op_name, op_symbol,item_size)%}
function Kernel.{{ op_name }}S(b: buffer, offset: number, scalar: number, count: number,step: number?)
    local _size = offset+count*item_size
    _size -=item_size
    
    local stepFactor = item_size * (step or 1)

    for pointer = offset, _size,stepFactor do
        buffer_write{{dtype}}(b, pointer, buffer_read{{dtype}}(b, pointer) {{ op_symbol }} scalar)        
    end
end
{%endmacro%}