{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate Kernel",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe CodeGenerators/kernels/renderer.py ${input:pickDtypes}",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "pickDtypes",
            "description": "Enter the data types to generate kernels for (space-separated, e.g., f32 i32 u8):",
            "type": "promptString"
        }
    ]
}