{
    "files.associations": {
        "*.luau.j2": "jinja-lua"
    },
    "luau-lsp.ignoreGlobs": [
        "**/CodeGenerators/**"
    ],
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python-envs.defaultPackageManager": "ms-python.python:pip",
    "json.schemas": [
        {
            "fileMatch": [
                "CodeGenerators/kernels/.config.json"
            ],
            "url": "./CodeGenerators/kernels/config_schema.json"
        }
    ]
}